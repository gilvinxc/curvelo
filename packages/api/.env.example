# Copy to .env and fill in. Never commit real secrets.
PORT=4000
DATABASE_URL=postgresql://curvelo:curvelo_dev@localhost:5432/curvelo_dev
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
CORS_ORIGIN=http://localhost:5173

# AI coaching assistance (optional). When both are set, Curvelo uses the LLM
# provider (Anthropic Messages API) for coaching narratives; otherwise the
# built-in local analyst generates insights with no key required.
# AI_API_KEY=sk-ant-...
# AI_MODEL=your-model-id
