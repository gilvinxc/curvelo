# Copy to .env and fill in. Never commit real secrets.
PORT=4000
DATABASE_URL=postgresql://curvelo:curvelo_dev@localhost:5432/curvelo_dev
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
CORS_ORIGIN=http://localhost:5173

# AI coaching assistance (optional). When both are set, Curvelo uses the LLM
# provider (Anthropic Messages API) for coaching narratives; otherwise the
# built-in local analyst generates insights with no key required.
# AI_API_KEY=sk-ant-...
# AI_MODEL=your-model-id

# Password reset emails (optional in dev). With RESEND_API_KEY set, mail goes
# through Resend; otherwise reset links are logged server-side.
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Curvelo <noreply@curvelo.app>
# WEB_URL=https://your-app.onrender.com

# Site admin bootstrap: comma-separated emails granted SYSTEM_ADMIN on
# register/login. The admin board can then manage roles without env changes.
# SYSTEM_ADMIN_EMAILS=you@example.com

# Document storage. Any S3-compatible store works (AWS S3, Cloudflare R2,
# Supabase Storage). Without these, uploads go to local disk (dev only —
# Render's disk is ephemeral).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=curvelo-docs
# S3_REGION=auto
# S3_ACCESS_KEY=xxx
# S3_SECRET_KEY=xxx
# STORAGE_LOCAL_DIR=./uploads

# Tracker integrations (COROS). Free, no application needed for the
# self-service tier. Tokens are encrypted at rest with this key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TRACKER_TOKEN_KEY=<32 random bytes, base64>
# COROS_MCP_URL=https://mcpus.coros.com  # US default; EU: https://mcpeu.coros.com
