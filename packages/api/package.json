{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@curvelo/shared": "0.1.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "fit-file-parser": "^6.1.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "name": "@curvelo/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "node scripts/with-engines.mjs prisma generate",
    "db:migrate": "node scripts/with-engines.mjs prisma migrate dev",
    "db:push": "node scripts/with-engines.mjs prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node scripts/with-engines.mjs vitest run"
