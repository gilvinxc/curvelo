// Curvelo — slice 1 schema: identity, teams, invitations, guardians,
// seasons, organizations, compliance rules, audit log.
// Later slices add: training plans, workouts, activities, feed,
// notifications, integrations, messaging.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  SYSTEM_ADMIN
}

enum TeamRole {
  COACH
  RUNNER
  PARENT
  TEAM_ADMIN
  ALUMNI
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum GuardianLinkStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum TeamVisibility {
  PRIVATE
  PUBLIC
}

enum ComplianceAppliesTo {
  COMMUNICATION
  WORKOUT_ASSIGNMENT
  EVENT
}

enum ComplianceAction {
  BLOCK
  REQUIRE_APPROVAL
  LOG_ONLY
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  displayName     String
  dateOfBirth     DateTime?
  systemRole      SystemRole?
  status          String    @default("ACTIVE")
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile             Profile?
  memberships         TeamMembership[]
  ownedTeams          Team[]              @relation("TeamOwner")
  sentInvitations     Invitation[]        @relation("InvitedBy")
  guardianLinksAsGuardian GuardianLink[]  @relation("Guardian")
  guardianLinksAsAthlete  GuardianLink[]  @relation("Athlete")
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  authoredWorkouts    Workout[]           @relation("WorkoutAuthor")
  authoredGroups      TeamGroup[]         @relation("GroupAuthor")
  authoredAssignments WorkoutAssignment[] @relation("AssignmentAuthor")
  receivedAssignments WorkoutAssignment[] @relation("AssignmentRecipient")
  groupMemberships    TeamGroupMember[]
  activities          Activity[]
  authoredPosts       FeedPost[]    @relation("PostAuthor")
  authoredComments    PostComment[] @relation("CommentAuthor")
  authoredReactions   PostReaction[] @relation("ReactionAuthor")
  authoredReports     PostReport[]  @relation("ReportAuthor")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  // Rotation chain: each refresh issues a new token and revokes the old one.
  // Reuse of a revoked token signals theft → revoke the whole family.
  familyId  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
}

model Profile {
  id                String  @id @default(uuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl         String?
  bio               String?
  city              String?
  units             String  @default("imperial")
  defaultShareLevel String  @default("SUMMARY")
  // Persona chosen at signup (COACH | RUNNER). Team permissions always
  // come from TeamMembership.role — persona is just the onboarding lens.
  persona           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Organization {
  id              String   @id @default(uuid())
  name            String
  type            String   @default("OTHER")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teams           Team[]
  complianceRules ComplianceRule[]
}

model Team {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  description    String?
  visibility     TeamVisibility @default(PRIVATE)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  ownerId        String
  owner          User           @relation("TeamOwner", fields: [ownerId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  memberships     TeamMembership[]
  invitations     Invitation[]
  seasons         Season[]
  complianceRules ComplianceRule[]
  workouts        Workout[]
  groups          TeamGroup[]
  assignments     WorkoutAssignment[]
  activities      Activity[]
  feedPosts       FeedPost[]
}

model TeamMembership {
  id        String           @id @default(uuid())
  teamId    String
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, status])
}

model Invitation {
  id          String           @id @default(uuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  role        TeamRole         @default(RUNNER)
  token       String           @unique
  invitedById String
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([email, status])
}

model GuardianLink {
  id           String             @id @default(uuid())
  guardianId   String
  guardian     User               @relation("Guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  athleteId    String
  athlete      User               @relation("Athlete", fields: [athleteId], references: [id], onDelete: Cascade)
  relationship String             @default("parent")
  status       GuardianLinkStatus @default(PENDING)
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([guardianId, athleteId])
  @@index([athleteId])
}

model Season {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, isActive])
}

model ComplianceRule {
  id             String              @id @default(uuid())
  name           String
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  appliesTo      ComplianceAppliesTo
  minAge         Int?
  maxAge         Int?
  startsAt       DateTime?
  endsAt         DateTime?
  action         ComplianceAction    @default(LOG_ONLY)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, isActive])
  @@index([teamId, isActive])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Slice 2: workouts, groups, assignments ──────────────────────────────

enum WorkoutKind {
  INTERVAL
  TEMPO
  PROGRESSION
  LONG_RUN
  RECOVERY
  RACE
  CROSS_TRAINING
  STRENGTH
  CUSTOM
}

enum WorkoutStepKind {
  WARMUP
  COOLDOWN
  INTERVAL
  RECOVERY
  STEADY
  REST
}

model Workout {
  id          String      @id @default(uuid())
  teamId      String
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title       String
  description String?
  kind        WorkoutKind @default(CUSTOM)
  isTemplate  Boolean     @default(false)
  createdById String
  createdBy   User        @relation("WorkoutAuthor", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  steps       WorkoutStep[]
  assignments WorkoutAssignment[]

  @@index([teamId, isTemplate])
}

model WorkoutStep {
  id          String          @id @default(uuid())
  workoutId   String
  workout     Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  order       Int
  kind        WorkoutStepKind
  distanceM   Float?
  durationS   Int?
  targetPaceS Float?
  targetHrBpm Int?
  targetRpe   Int?
  repetitions Int             @default(1)
  notes       String?

  @@index([workoutId, order])
}

model TeamGroup {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  createdById String
  createdBy   User     @relation("GroupAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TeamGroupMember[]
  assignments WorkoutAssignment[]

  @@unique([teamId, name])
}

model TeamGroupMember {
  id        String    @id @default(uuid())
  groupId   String
  group     TeamGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model WorkoutAssignment {
  id               String     @id @default(uuid())
  workoutId        String
  workout          Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  teamId           String
  team             Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Target: whole team (both null), one group, or one athlete.
  assignedToUserId String?
  assignedToUser   User?      @relation("AssignmentRecipient", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  groupId          String?
  group            TeamGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  scheduledDate    DateTime   @db.Date
  notes            String?
  needsApproval    Boolean    @default(false)
  createdById      String
  createdBy        User       @relation("AssignmentAuthor", fields: [createdById], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  completions Activity[] @relation("AssignmentCompletions")

  @@index([teamId, scheduledDate])
  @@index([assignedToUserId, scheduledDate])
  @@index([groupId, scheduledDate])
}

// ─── Slice 3: manual activity logging ────────────────────────────────────

enum ActivityKind {
  RUN
  WALK
  CROSS_TRAINING
  STRENGTH
  REST_DAY
  OTHER
}

enum ActivitySource {
  MANUAL
  GARMIN
  STRAVA
  APPLE_HEALTH
  GOOGLE_HEALTH
  FILE_IMPORT
}

model Activity {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId       String?
  team         Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   WorkoutAssignment? @relation("AssignmentCompletions", fields: [assignmentId], references: [id], onDelete: SetNull)
  kind         ActivityKind   @default(RUN)
  title        String?
  startedAt    DateTime
  distanceM    Float?
  durationS    Int?
  avgPaceS     Float?
  avgHrBpm     Int?
  maxHrBpm     Int?
  effortRpe    Int?
  calories     Int?
  notes        String?
  source       ActivitySource @default(MANUAL)
  externalId   String?
  visibility   String         @default("TEAM") // PRIVATE | TEAM

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sharedInPosts FeedPost[] @relation("SharedInPosts")

  @@index([userId, startedAt])
  @@index([teamId, startedAt])
  @@unique([source, externalId])
}

// ─── Slice 4: private team social feed ───────────────────────────────────

enum PostKind {
  TEXT
  ACTIVITY_SHARE
}

model FeedPost {
  id         String   @id @default(uuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  kind       PostKind @default(TEXT)
  body       String?
  activityId String?
  activity   Activity? @relation("SharedInPosts", fields: [activityId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comments  PostComment[]
  reactions PostReaction[]
  reports   PostReport[]

  @@index([teamId, createdAt])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
}

model PostReaction {
  id        String   @id @default(uuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId])
}

model PostReport {
  id         String   @id @default(uuid())
  postId     String
  post       FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([postId])
  @@index([status])
}
