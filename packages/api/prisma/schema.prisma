// Curvelo — slice 1 schema: identity, teams, invitations, guardians,
// seasons, organizations, compliance rules, audit log.
// Later slices add: training plans, workouts, activities, feed,
// notifications, integrations, messaging.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  SYSTEM_ADMIN
}

enum TeamRole {
  COACH
  RUNNER
  PARENT
  TEAM_ADMIN
  ALUMNI
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum GuardianLinkStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum TeamVisibility {
  PRIVATE
  PUBLIC
}

enum ComplianceAppliesTo {
  COMMUNICATION
  WORKOUT_ASSIGNMENT
  EVENT
}

enum ComplianceAction {
  BLOCK
  REQUIRE_APPROVAL
  LOG_ONLY
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String
  displayName     String
  dateOfBirth     DateTime?
  systemRole      SystemRole?
  status          String      @default("ACTIVE")
  emailVerifiedAt DateTime?
  avatarImage     Bytes?
  avatarMime      String?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  profile                   Profile?
  memberships               TeamMembership[]
  ownedTeams                Team[]               @relation("TeamOwner")
  sentInvitations           Invitation[]         @relation("InvitedBy")
  guardianLinksAsGuardian   GuardianLink[]       @relation("Guardian")
  guardianLinksAsAthlete    GuardianLink[]       @relation("Athlete")
  auditLogs                 AuditLog[]
  refreshTokens             RefreshToken[]
  passwordResetTokens       PasswordResetToken[]
  ownedDocuments            Document[]           @relation("DocumentOwner")
  verifiedDocuments         Document[]           @relation("DocumentVerifier")
  uploadedDocuments         Document[]           @relation("DocumentUploader")
  authoredWorkouts          Workout[]            @relation("WorkoutAuthor")
  createdTrainingPlans      TrainingPlan[]       @relation("TrainingPlanAuthor")
  createdTeamEvents         TeamEvent[]          @relation("TeamEventAuthor")
  assignedPlanDays          TrainingPlanDay[]    @relation("TrainingPlanDayAssignee")
  authoredGroups            TeamGroup[]          @relation("GroupAuthor")
  authoredAssignments       WorkoutAssignment[]  @relation("AssignmentAuthor")
  receivedAssignments       WorkoutAssignment[]  @relation("AssignmentRecipient")
  groupMemberships          TeamGroupMember[]
  activities                Activity[]
  activityTags              ActivityTag[]          @relation("TaggedUser")
  personalPlans           PersonalPlan[]
  loggedActivities          Activity[]           @relation("ActivityLogger")
  authoredPosts             FeedPost[]           @relation("PostAuthor")
  authoredComments          PostComment[]        @relation("CommentAuthor")
  authoredReactions         PostReaction[]       @relation("ReactionAuthor")
  authoredReports           PostReport[]         @relation("ReportAuthor")
  injuriesAsAthlete         Injury[]               @relation("InjuryAthlete")
  feedback                Feedback[]
  injuriesReported          Injury[]               @relation("InjuryReporter")
  guardianInvitesForAthlete GuardianInvite[]     @relation("GuardianInviteAthlete")
  guardianInvitesAuthored   GuardianInvite[]     @relation("GuardianInviteAuthor")
  consentsForAthlete        Consent[]            @relation("ConsentAthlete")
  consentsAsGuardian        Consent[]            @relation("ConsentGuardian")
  conversationsAuthored     Conversation[]       @relation("ConversationAuthor")
  conversationParticipations  ConversationParticipant[]
  messagesAuthored          Message[]            @relation("MessageAuthor")
  createdJoinLinks          TeamJoinLink[]       @relation("JoinLinkCreator")
  seasonsCreated            Season[]             @relation("SeasonCreator")
  personalGoals             Goal[]               @relation("PersonalGoals")
  createdGoals              Goal[]               @relation("GoalCreator")
  raceResults               RaceResult[]         @relation("UserRaceResults")
  awards                    Award[]              @relation("UserAwards")
  shoes                     Shoe[]               @relation("UserShoes")
  joinRequests              TeamJoinRequest[]
  decidedJoinRequests       TeamJoinRequest[]    @relation("JoinRequestDecider")
  mentionsReceived          Mention[]            @relation("MentionedUser")
  mentionsGiven             Mention[]            @relation("Mentioner")
  notifications             Notification[]
  uploadedPhotos            Photo[]              @relation("PhotoUploader")
  reviewedPhotos            Photo[]              @relation("PhotoReviewer")
  createdAlbums             Album[]              @relation("AlbumAuthor")
  trackerConnections        TrackerConnection[]  @relation("UserTrackerConnections")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  // Rotation chain: each refresh issues a new token and revokes the old one.
  // Reuse of a revoked token signals theft → revoke the whole family.
  familyId  String
  createdAt DateTime  @default(now())

  // Set when this session was opened by a site admin via "View as".
  // Exit restores the admin's own session; audit-logged on start and end.
  impersonatedByAdminId String?

  @@index([userId])
  @@index([familyId])
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl         String?
  bio               String?
  city              String?
  units             String   @default("imperial")
  defaultShareLevel String   @default("SUMMARY")
  phone             String?
  emergencyName     String?
  emergencyPhone    String?
  heightCm          Float?
  weightKg          Float?
  // Persona chosen at signup (COACH | RUNNER). Team permissions always
  // come from TeamMembership.role — persona is just the onboarding lens.
  persona           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("OTHER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams           Team[]
  complianceRules ComplianceRule[]
}

model Team {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  description    String?
  visibility     TeamVisibility @default(PRIVATE)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  ownerId        String
  owner          User           @relation("TeamOwner", fields: [ownerId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  memberships          TeamMembership[]
  awards               Award[]
  invitations          Invitation[]
  joinLinks            TeamJoinLink[]
  joinRequests         TeamJoinRequest[]
  goals                Goal[]                @relation("TeamGoals")
  logoImage            Bytes?
  logoMime             String?
  seasons              Season[]
  complianceRules      ComplianceRule[]
  workouts             Workout[]
  groups               TeamGroup[]
  assignments          WorkoutAssignment[]
  activities           Activity[]
  feedPosts            FeedPost[]
  injuries             Injury[]
  feedback             Feedback[]
  guardianInvites      GuardianInvite[]
  consents             Consent[]
  conversations        Conversation[]
  documentRequirements DocumentRequirement[]
  documents            Document[]
  trainingPlans        TrainingPlan[]
  events               TeamEvent[]
  Mention              Mention[]
  albums               Album[]
  photos               Photo[]
}

// ─── Slice 6: team messaging (youth-safe, no private DMs) ───────────────

model Conversation {
  id          String     @id @default(uuid())
  teamId      String
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  kind        String // ANNOUNCEMENT | TEAM_CHAT | GROUP_CHAT | CHECK_IN
  groupId     String?
  group       TeamGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scopeKey    String // "ANNOUNCEMENT:-" | "TEAM_CHAT:-" | "GROUP_CHAT:<groupId>"
  title       String
  createdById String
  createdBy   User       @relation("ConversationAuthor", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  messages    Message[]
  participants ConversationParticipant[]

  @@unique([teamId, scopeKey])
  @@index([teamId])
}

// Per-conversation membership for CHECK_IN channels (coach + runner +
// the runner's verified guardians). Other conversation kinds use
// team/group membership instead.
model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedById    String?

  @@index([conversationId, createdAt])
}

model TeamMembership {
  id        String           @id @default(uuid())
  teamId    String
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, status])
}

model Invitation {
  id          String           @id @default(uuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  role        TeamRole         @default(RUNNER)
  token       String           @unique
  invitedById String
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([email, status])
}

model GuardianLink {
  id           String             @id @default(uuid())
  guardianId   String
  guardian     User               @relation("Guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  athleteId    String
  athlete      User               @relation("Athlete", fields: [athleteId], references: [id], onDelete: Cascade)
  relationship String             @default("parent")
  status       GuardianLinkStatus @default(PENDING)
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([guardianId, athleteId])
  @@index([athleteId])
}

model Season {
  id               String   @id @default(uuid())
  teamId           String
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name             String
  startsAt         DateTime
  endsAt           DateTime
  isActive         Boolean  @default(false)
  championshipName String?
  championshipDate DateTime?
  createdById      String?
  createdBy        User?    @relation("SeasonCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([teamId, isActive])
}

model ComplianceRule {
  id             String              @id @default(uuid())
  name           String
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  appliesTo      ComplianceAppliesTo
  minAge         Int?
  maxAge         Int?
  startsAt       DateTime?
  endsAt         DateTime?
  action         ComplianceAction    @default(LOG_ONLY)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, isActive])
  @@index([teamId, isActive])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Auth: password reset ────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Slice 2: workouts, groups, assignments ──────────────────────────────

enum WorkoutKind {
  INTERVAL
  TEMPO
  PROGRESSION
  LONG_RUN
  RECOVERY
  RACE
  CROSS_TRAINING
  STRENGTH
  CUSTOM
}

enum WorkoutStepKind {
  WARMUP
  COOLDOWN
  INTERVAL
  RECOVERY
  STEADY
  REST
}

model Workout {
  id          String      @id @default(uuid())
  teamId      String
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title       String
  description String?
  kind        WorkoutKind @default(CUSTOM)
  isTemplate  Boolean     @default(false)
  createdById String
  createdBy   User        @relation("WorkoutAuthor", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  steps       WorkoutStep[]
  assignments WorkoutAssignment[]
  planDays    TrainingPlanDay[]

  @@index([teamId, isTemplate])
}

model WorkoutStep {
  id          String          @id @default(uuid())
  workoutId   String
  workout     Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  order       Int
  kind        WorkoutStepKind
  distanceM   Float?
  durationS   Int?
  targetPaceS Float?
  targetHrBpm Int?
  targetRpe   Int?
  repetitions Int             @default(1)
  notes       String?

  @@index([workoutId, order])
}

model TeamGroup {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  createdById String
  createdBy   User     @relation("GroupAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       TeamGroupMember[]
  assignments   WorkoutAssignment[]
  conversations Conversation[]
  planDays      TrainingPlanDay[]

  @@unique([teamId, name])
}

model TeamGroupMember {
  id        String    @id @default(uuid())
  groupId   String
  group     TeamGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model WorkoutAssignment {
  id               String     @id @default(uuid())
  workoutId        String
  workout          Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  teamId           String
  team             Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Target: whole team (both null), one group, or one athlete.
  assignedToUserId String?
  assignedToUser   User?      @relation("AssignmentRecipient", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  groupId          String?
  group            TeamGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  scheduledDate    DateTime   @db.Date
  notes            String?
  needsApproval    Boolean    @default(false)
  createdById      String
  createdBy        User       @relation("AssignmentAuthor", fields: [createdById], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  completions Activity[] @relation("AssignmentCompletions")

  @@index([teamId, scheduledDate])
  @@index([assignedToUserId, scheduledDate])
  @@index([groupId, scheduledDate])
}

// ─── Slice 3: manual activity logging ────────────────────────────────────

enum ActivityKind {
  RUN
  WALK
  CROSS_TRAINING
  STRENGTH
  REST_DAY
  OTHER
}

enum ActivitySource {
  MANUAL
  GARMIN
  STRAVA
  COROS
  APPLE_HEALTH
  GOOGLE_HEALTH
  FILE_IMPORT
}

model Activity {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId           String?
  team             Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignmentId     String?
  assignment       WorkoutAssignment? @relation("AssignmentCompletions", fields: [assignmentId], references: [id], onDelete: SetNull)
  kind             ActivityKind       @default(RUN)
  title            String?
  startedAt        DateTime
  distanceM        Float?
  durationS        Int?
  elevationGainM   Float?
  avgCadenceSpm  Int?
  avgPaceS         Float?
  avgHrBpm         Int?
  maxHrBpm         Int?
  effortRpe        Int?
  calories         Int?
  steps            Int?
  city             String?
  cityLat          Float?
  cityLon          Float?
  terrain          String?
  weatherTempC     Float?
  weatherCondition String?
  notes            String?
  source           ActivitySource     @default(MANUAL)
  externalId       String?
  visibility       String             @default("TEAM") // PRIVATE | TEAM
  shoeId           String?
  shoe             Shoe?              @relation(fields: [shoeId], references: [id], onDelete: SetNull)
  raceResult       RaceResult?        @relation("ActivityRaceResult")
  // Who entered this activity; null = the athlete themself. Coaches (and
  // later guardians) can log on someone's behalf; the run still belongs to
  // the athlete.
  loggedByUserId   String?
  loggedBy         User?              @relation("ActivityLogger", fields: [loggedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sharedInPosts FeedPost[] @relation("SharedInPosts")
  splits        ActivitySplit[]
  route         ActivityRoute?
  tags          ActivityTag[]

  @@unique([source, externalId])
  @@index([userId, startedAt])
  @@index([teamId, startedAt])
}

// ─── Teammate tags: "I ran with you — add it to your log?" ────────────────
// Tagging is opt-in on both sides: the tagger picks teammates, each tagged
// user approves (prefilled, editable) or declines. Never auto-logs.

model ActivityTag {
  id           String   @id @default(uuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  taggedUserId String
  taggedUser   User     @relation("TaggedUser", fields: [taggedUserId], references: [id], onDelete: Cascade)
  // PENDING | ACCEPTED | DECLINED | INVALIDATED (source went private/deleted)
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  respondedAt  DateTime?

  @@unique([activityId, taggedUserId])
  @@index([taggedUserId, status])
}

// ─── Lap splits: per-lap distance/duration for an activity ────────────────

model ActivitySplit {
  id         String   @id @default(uuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  position   Int
  distanceM  Float?
  durationS  Int?

  @@index([activityId, position])
}

// ─── GPS route: simplified trackpoints, owner + verified guardians only ───

model ActivityRoute {
  id         String   @id @default(uuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  // Simplified [lat, lon] pairs, max 500 points.
  points     Json
  createdAt  DateTime @default(now())
}

// ─── Slice 4: private team social feed ───────────────────────────────────

enum PostKind {
  TEXT
  ACTIVITY_SHARE
  MILESTONE
  SHOUTOUT
  WELCOME
}

model FeedPost {
  id         String    @id @default(uuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  kind       PostKind  @default(TEXT)
  body       String?
  activityId String?
  activity   Activity? @relation("SharedInPosts", fields: [activityId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  comments  PostComment[]
  reactions PostReaction[]
  reports   PostReport[]
  photos    Photo[]

  @@index([teamId, createdAt])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
}

model PostReaction {
  id        String   @id @default(uuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId])
}

model PostReport {
  id         String    @id @default(uuid())
  postId     String
  post       FeedPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User      @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([postId])
  @@index([status])
}

// ─── Slice 5: guardians & parental consent ───────────────────────────────

model GuardianInvite {
  id           String   @id @default(uuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athleteId    String
  athlete      User     @relation("GuardianInviteAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  email        String
  relationship String   @default("parent")
  token        String   @unique
  status       String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  expiresAt    DateTime
  createdById  String
  createdBy    User     @relation("GuardianInviteAuthor", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([athleteId])
  @@index([email])
}

model Consent {
  id         String    @id @default(uuid())
  athleteId  String
  athlete    User      @relation("ConsentAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   User      @relation("ConsentGuardian", fields: [guardianId], references: [id], onDelete: Cascade)
  teamId     String?
  team       Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  type       String // PARTICIPATION | DATA_SHARING
  status     String    @default("GRANTED") // GRANTED | REVOKED
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@unique([athleteId, guardianId, type])
  @@index([athleteId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// Shareable invite link: anyone with the token can request to join.
// Requests always need a coach/admin approval — links never auto-join.
model TeamJoinLink {
  id          String    @id @default(uuid())
  token       String    @unique
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("JoinLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  maxUses     Int?
  useCount    Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  requests TeamJoinRequest[]

  @@index([teamId])
}

model TeamJoinRequest {
  id          String            @id @default(uuid())
  teamId      String
  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkId      String?
  link        TeamJoinLink?     @relation(fields: [linkId], references: [id], onDelete: SetNull)
  status      JoinRequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?             @relation("JoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())

  @@index([teamId, status])
  @@index([userId])
}

enum GoalKind {
  DISTANCE
  SESSIONS
  STREAK
}

enum GoalPeriod {
  WEEK
  MONTH
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

// Personal goal: userId set. Team goal: teamId set (collective).
model Goal {
  id              String     @id @default(uuid())
  userId          String?
  user            User?      @relation("PersonalGoals", fields: [userId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?      @relation("TeamGoals", fields: [teamId], references: [id], onDelete: Cascade)
  kind            GoalKind
  period          GoalPeriod
  title           String?
  targetMeters    Int? // DISTANCE goals, canonical meters
  targetCount     Int? // SESSIONS / STREAK goals
  startAt         DateTime
  endAt           DateTime
  recurring       Boolean    @default(false) // personal WEEK/MONTH goals roll over
  status          GoalStatus @default(ACTIVE)
  shareOnComplete Boolean    @default(false) // personal: celebrate in team feed
  feedTeamId      String?
  createdById     String
  createdBy       User       @relation("GoalCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  completedAt     DateTime?

  @@index([userId, status])
  @@index([teamId, status])
}

// Official race result — exact distance, exact time. PRs come from these,
// never estimated from training runs.
enum AwardType {
  MEDAL
  TROPHY
  RIBBON
  PLAQUE
  OTHER
}

// Coach-logged recognition: medals, trophies, ribbons. Never automatic.
model Award {
  id        String    @id @default(uuid())
  athleteId String
  athlete   User      @relation("UserAwards", fields: [athleteId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type      AwardType
  place     Int?
  eventName String
  eventDate DateTime
  notes     String?
  createdAt DateTime  @default(now())

  @@index([athleteId])
  @@index([teamId])
}

model RaceResult {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation("UserRaceResults", fields: [userId], references: [id], onDelete: Cascade)
  activityId    String?   @unique
  activity      Activity? @relation("ActivityRaceResult", fields: [activityId], references: [id], onDelete: SetNull)
  raceName      String
  distanceM     Int
  durationS     Int
  racedAt       DateTime
  // Per-segment splits: [{ distanceM: number, durationS: number }].
  splits        Json?
  finishPlace   Int?
  ageGroupPlace Int?
  // How many athletes were in the race (for place context).
  fieldSize     Int?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

// A runner's shoes; mileage accumulates from linked activities.
model Shoe {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation("UserShoes", fields: [userId], references: [id], onDelete: Cascade)
  name       String
  brand      String?
  model      String?
  retired    Boolean    @default(false)
  retiredAt  DateTime?
  isDefault  Boolean    @default(false)
  lifespanM  Int          @default(500000)
  createdAt  DateTime   @default(now())
  activities Activity[]

  @@index([userId])
}

// ─── Documents: athlete paperwork, coach certs, team docs ────────────────

enum DocumentKind {
  PHYSICAL
  CONCUSSION
  WAIVER
  BIRTH_CERTIFICATE
  CERTIFICATION
  BACKGROUND_CHECK
  TEAM_DOC
  OTHER
}

enum DocumentVisibility {
  TEAM
  COACH_ONLY
}

// Coach-defined checklist: what each athlete must keep current.
model DocumentRequirement {
  id        String       @id @default(uuid())
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  kind      DocumentKind
  label     String
  validDays Int?
  required  Boolean      @default(true)
  createdAt DateTime     @default(now())
  documents Document[]

  @@unique([teamId, kind])
  @@index([teamId])
}

// A stored file's metadata. Bytes live in object storage (or local disk in
// dev); Postgres only keeps metadata. Never store full background reports.
model Document {
  id               String               @id @default(uuid())
  teamId           String?
  team             Team?                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ownerId          String?
  owner            User?                @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  kind             DocumentKind
  label            String
  requirementId    String?
  requirement      DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  storageKey       String
  fileName         String
  mimeType         String
  sizeBytes        Int
  checksum         String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  // Coach verification (birth certificates, physicals).
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedBy       User?                @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  // E-signature (waivers, concussion acks): explicit intent, ESIGN/UETA.
  signedByName     String?
  signedAt         DateTime?
  signIntent       Boolean              @default(false)
  // Background checks: pass/fail only, never the full report.
  checkResult      String?
  checkProvider    String?
  visibility       DocumentVisibility   @default(TEAM)
  version          Int                  @default(1)
  supersededById   String?
  supersededBy     Document?            @relation("DocumentVersions", fields: [supersededById], references: [id], onDelete: SetNull)
  previousVersions Document[]           @relation("DocumentVersions")
  uploadedById     String
  uploadedBy       User                 @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([teamId])
  @@index([ownerId])
  @@index([requirementId])
}

// Coach practice-planning: reusable week templates ("Base week", "Race week").
// dayOfWeek: 0 = Monday .. 6 = Sunday.
model TrainingPlan {
  id          String            @id @default(uuid())
  teamId      String
  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdById String
  createdBy   User              @relation("TrainingPlanAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  days        TrainingPlanDay[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([teamId])
}

model TrainingPlanDay {
  id               String       @id @default(uuid())
  planId           String
  plan             TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOfWeek        Int
  workoutId        String
  workout          Workout      @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  groupId          String?
  group            TeamGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assignedToUserId String?
  assignedTo       User?        @relation("TrainingPlanDayAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  notes            String?

  @@index([planId])
}

// Team calendar events: practices, meetings, race days (with itineraries),
// socials. Optional weekly recurrence expands into occurrences on read.
model TeamEvent {
  id          String    @id @default(uuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title       String
  description String?
  eventType   String // PRACTICE | MEETING | RACE | SOCIAL | OTHER
  startAt     DateTime
  endAt       DateTime?
  location    String?
  itinerary   String?
  recurrence  Json?
  createdById String
  createdBy   User      @relation("TeamEventAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([teamId])
}

model Mention {
  id              String   @id @default(uuid())
  mentionedUserId String
  mentionedUser   User     @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  mentionerId     String
  mentioner       User     @relation("Mentioner", fields: [mentionerId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  targetType      String // POST | COMMENT | MESSAGE | ACTIVITY
  targetId        String
  // The display name as typed after the @, for rendering links.
  displayName     String
  createdAt       DateTime @default(now())

  @@unique([targetType, targetId, mentionedUserId])
  @@index([mentionedUserId, createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // MENTION (more types later)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Album {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdById String
  createdBy   User     @relation("AlbumAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  photos      Photo[]

  @@index([teamId, createdAt])
}

model Photo {
  id           String    @id @default(uuid())
  teamId       String
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  albumId      String?
  album        Album?    @relation(fields: [albumId], references: [id], onDelete: SetNull)
  postId       String?
  post         FeedPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  uploaderId   String
  uploader     User      @relation("PhotoUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  storageKey   String
  mimeType     String
  sizeBytes    Int
  caption      String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewedBy   User?     @relation("PhotoReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([teamId, status, createdAt])
  @@index([albumId, createdAt])
}

model TrackerConnection {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation("UserTrackerConnections", fields: [userId], references: [id], onDelete: Cascade)
  provider       String   // COROS
  providerUserId String?
  accessToken    String   // encrypted
  refreshToken   String?  // encrypted
  expiresAt      DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, provider])
  @@index([provider])
}

model TrackerOAuthState {
  state        String   @id
  userId       String
  provider     String
  codeVerifier String
  redirectUri  String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

model TrackerOAuthClient {
  provider   String   @id // COROS
  clientId   String
  createdAt  DateTime @default(now())
}

/// An individual's own training plan: a dated list of plain-text workouts.
/// Visible to the owner and to coaches/admins of the owner's teams.
model PersonalPlan {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  applied     Boolean           @default(false)
  days        PersonalPlanDay[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
}

model PersonalPlanDay {
  id        String       @id @default(uuid())
  planId    String
  plan      PersonalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  date      DateTime
  title     String
  notes     String?
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([planId, date])
}

enum InjuryStatus {
  ACTIVE
  RECOVERED
}

/// Coach-managed injury log. Sensitive health info: visible to coaches,
/// the athlete, and their verified guardians — never the full team.
model Injury {
  id             String       @id @default(uuid())
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athleteId      String
  athlete        User         @relation("InjuryAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  reportedById   String
  reportedBy     User         @relation("InjuryReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  title          String
  detail         String?
  status         InjuryStatus @default(ACTIVE)
  expectedReturn DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([teamId, status])
  @@index([athleteId, status])
}

enum FeedbackCategory {
  BUG
  FEATURE
  OTHER
}

enum FeedbackStatus {
  OPEN
  REVIEWED
  RESOLVED
}

/// In-app feedback: bug reports and feature requests. Visible to system
/// admins for product insights; users see only their own.
model Feedback {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String?
  team      Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  category  FeedbackCategory @default(OTHER)
  body      String
  status    FeedbackStatus   @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}
